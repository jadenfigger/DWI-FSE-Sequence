int deg_90, deg_117, rfsp_on ;
long rf_inc, rf_sp_temp ;
int deg_360, overhead; 
long phase_ang;
int remainder_phase, phase_correction, phase_correction_0, phase_correction_1, phase_correction_2;
common int rf_on;

\\ Patient orientation and rf calibration value
common int subj_angle_x, subj_angle_y, subj_angle_z, rfcal;

\\ frequency control
