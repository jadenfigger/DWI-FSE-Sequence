        VAR_15.PPH

Author:         MR Solutions Ltd
Date:           10 February 2022
Version:        2.0

This include file contains a set of definitions of variables for
control of loops, timings, frequency control and gradient and RF
amplitudes

**************************************************************/


\\ looping control
int no_echoes, current_echo;
int no_slices, current_slice, slice_interleave;
int batch_slices = 0;
int batch_interleave = 1;
int no_averages, image_av;
int no_views, current_view, echo_cnt;
int sample_period, no_samples, no_discard;
int view_block, view_av, views_per_seg;
int slice_block, slice_av;
int phase_cycle, no_acq;
common int obs_mod_level;

\\ temp_mac and temp_mac_long are reserved for macro usage and therefore
\\ MUST NOT BE USED in a ppl program
