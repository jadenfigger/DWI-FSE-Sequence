long temp_mac_long;


\\ timing variables
int group_delay;
int trmin, clock, tfilter = 373, tref, time, tr_extend;
\\int tr_ms, tr_us, te_ms, te_us, ret, t_refocus, t_refocus_2 ;
int te_ms, te_us, te_ms_2, te_us_2;
int ret;
common int tr, te, te_eff, report_on;
long tacq;  /* Narrow bandwidths have tacq > 32767 usec !! */
long templ1, templ2, templ3, templ4, templ5, tr_min ; /* Used for complicated calculations */
\\long tass ;
common int t_gs_comp, tcrush;
int asymm;

