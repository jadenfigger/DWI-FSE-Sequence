\\int mtc_delay_cal, tselmtc, mtc_delay_min, mtc_rfnum, mtc_amp, mtc_mat, mtc_list;

\\ PRE-SAT pulse
common int  p_sat_scale, sat_tcrush, sat_gr_amp;
int rfnum_sat, tsel_sat, sat_pulse_bwdth, fov_sat_slice_freq, sat_crush_amp, satgs_on;
