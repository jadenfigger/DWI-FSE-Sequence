common int grad_amp;

/* Variables for gradient control. All the PPL variables for offsets, FOV 
slice thickness and slice separation ar defined as common ints this is
necessary to allow real time update of the orientation variables */
int slice_list, read_list, phase_list;
int scale_read_off, scale_phase_off, scale_slice_off;
int fov_read_freq, fov_PHASE_deg, fov_slice_freq,  new_slice_offset;
int gp_inc, gp_var, dacmax = 32767;  /* 16 bit maximum */
int gp_init_var_rescale, gs_var_rescale;
int oversample, oversample2, gr_oversample, gr_undersample, gp_oversample, gp_undersample;
int grad_var[4], grad_var_l[4], tramp, gp_init_var, gr_var, gr_var_s, gs_var;
int gr_comp, gr_comp_s, gs_comp, gs_comp_s, gr_crush, gs_crush, gp_crush;
long dacmaxlong = 32767l;/* 16 bit maximum defined as a long */
common int gr_comp_scale, gs_comp_scale, gr_on, gp_on, gs_on;

\\ Variables for RF control and phase cycle and spoil
int phase_90, phase_180, phase_117, tsel90, tsel180;
common int p90_mul, p180_mul;
int warmup    = 20;  /* Warmup time for   rf amplifier  */
int phase_res = 225; /* Phase resolution*1000 (for PTS 310 =  0.225 deg */
int rfnum, phase_rec, phase_rec_cal1, phase_rec_cal2, rf_length[40], rf_bwdth[40], rad[40], rwt[40], rbd[40];
common int p180_scale, alpha;

\\ orientation variables
#ifdef MAO
#define POS_INDEX [pos_index]
int pos_index;
int fov_read_off[MAX_SLICE], fov_PHASE_off[MAX_SLICE], fov_slice_off[MAX_SLICE];
int phase_var, s_angle_var[MAX_SLICE], p_angle_var[MAX_SLICE], r_angle_var[MAX_SLICE];
#else
#define POS_INDEX
int fov_read_off, fov_PHASE_off, fov_slice_off;
common int phase_var, s_angle_var, p_angle_var, r_angle_var;
#endif

#define true -1
#define false 0

#define LONGDELAY(longval) temp_mac_long = longval - 140;\
temp_mac = temp_mac_long/1000L;\
if (temp_mac > 0 ) delay(temp_mac, ms);\
temp_mac = temp_mac_long - (temp_mac*1000L);\
if (temp_mac > 4 ) delay(temp_mac, us);  

#define US_TO_MS(us,ms) ms = (us/1000L) + (us - (us/1000L)*1000L)/500L ;

