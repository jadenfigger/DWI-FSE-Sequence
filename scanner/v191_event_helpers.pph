/* V191 event helpers, using uploaded MR Solutions interfaces.
   These helpers are not a sequence entry point. Compiler/event-trace approval
   is pending; v191's entry point remains blocked until the whole shot is ready.

   Each setup window is padded to 1000 us. The actual played-gradient duration
   is supplied by the verified frame/list mapping, never inferred from a name.
   LONGDELAY is the actual macro in utilities/var_20.pph (minimum 150 us).
   No argument passed to delay is an uncompiled arithmetic expression.
*/

/* All variables below are declared at the beginning of main, before statements.
   temp_mac/temp_mac_long belong to vendor macros and are not persistent state.
*/
int v191_mode, v191_cycles, v191_spoil_cycles, v191_slab_ratio;
int v191_rf_slot, v191_rf_scale, v191_rf_phase, v191_rf_dur;
int v191_grad_list, v191_grad_mat, v191_grad_chan, v191_grad_clock;
int v191_rf_pred, v191_setup_ticks;
long v191_grad_dur, v191_delay_us;
int v191_window_ticks, v191_elapsed_ticks;
long v191_elapsed_long;

/* Set phase/RF while gradients are zero and before the timed gradient block.
   Do not call while a prior RF frame is still playing. The source audit must
   prove the 1000 us window including all argument evaluation and function costs.
   The 450 us threshold reserves the documented approximately 360 us timing-
   function overhead plus closing argument/branch cost within the 1000 us pad.
   gettimer has a signed 16-bit result; limit is deliberately below 32767 ticks.
*/
#define V191_PREPARE_RF starttimer();\
phase(v191_rf_phase);\
NEWSHAPE_SETUP(v191_rf_slot, v191_rf_scale)\
v191_setup_ticks=gettimer();\
if ((v191_setup_ticks<0)||(v191_setup_ticks>4500)) {\
printf("V191 RF setup exceeded 1000 us padded window\n");\
goto end; }\
waittimer(10000);

/* Gradient matrix must have finished DSP calculation >=caldelay before entry.
   A SetList/SelectMatrix does not itself construct or settle the matrix.
   Padded setup is repeated for every event so event metadata can name both
   duration and idle setup time; setup cannot be hidden inside an echo interval.
*/
#define V191_PREPARE_GRAD starttimer();\
MR3040_SetList(v191_grad_list,v191_grad_chan);\
MR3040_SelectMatrix(v191_grad_mat);\
MR3040_Clock(v191_grad_clock);\
v191_setup_ticks=gettimer();\
if ((v191_setup_ticks<0)||(v191_setup_ticks>4500)) {\
printf("V191 gradient setup exceeded 1000 us padded window\n");\
goto end; }\
waittimer(10000);

/* Standalone finite gradient block. A duration below 150 us is rejected before
   use of LONGDELAY. The list must finish at zero, without HOLD or CONTINUE.
   This helper does not erase local transverse magnetization after a spoiler.
*/
#define V191_PLAY_GRAD if ((v191_grad_dur<150L)||(v191_grad_dur>32767000L)) {\
printf("V191 gradient duration outside LONGDELAY range\n");\
goto end; }\
MR3040_Start(v191_grad_chan);\
LONGDELAY(v191_grad_dur)

/* RF is played using the uploaded library macro exactly, including its gate,
   warmup, multiplier and RF-off behavior. MR3031_RFSTART performs its own
   NEWSHAPE_SETUP, so V191_PREPARE_RF is not used in this helper's path.
   RF phase must have been set before the timed gradient start.

   RF-start pred is a duration from the vendor macro entry, not a paper RF center.
   The phase/gradient/RF/ADC timing ledger must include the inherited macro's
   actual executed statements and final hardware trigger latency separately.
*/
#define V191_VALIDATE_RF if ((v191_rf_slot<1)||(v191_rf_slot>39)||\
(v191_rf_scale<1)||(v191_rf_scale>2047)||\
(v191_rf_dur<5)||(v191_rf_pred<44)) {\
printf("V191 RF index, scale, duration or start delay invalid\n");\
goto end; }

/* Validation is required in preflight, before timed playback, for every actual
   RF table entry and scale. It is not inserted between gradient start and RF.
*/
#define V191_PLAY_RF \
MR3031_RFSTART(v191_rf_slot,v191_rf_dur,v191_rf_scale,v191_rf_pred,rf_on)

/* Coarse interval between explicit events, never a silent fallback for a
   negative timing budget. This macro clobbers vendor temporary variables.
*/
#define V191_DELAY if ((v191_delay_us<150L)||(v191_delay_us>32767000L)) {\
printf("V191 timing gap infeasible (must be 150 us to 32767 ms)\n");\
goto end; }\
LONGDELAY(v191_delay_us)

/* Fixed playback window for a finite gradient/RF list shorter than 4.4 ms.
   Setup is a separately played 1 ms window. Launch time is explicitly after
   starttimer; the list must finish within grad_dur, leaving 500 us for gettimer
   and closing checks. No arbitrary reserve is subtracted without being played.
   Arrays/parameters are validated before entering the shot.
*/
#define V191_FIXED_START starttimer();\
MR3040_SelectMatrix(v191_grad_mat);\
MR3040_SetList(v191_grad_list,v191_grad_chan);\
MR3040_Clock(v191_grad_clock);\
phase(v191_rf_phase);\
v191_setup_ticks=gettimer();\
if ((v191_setup_ticks<0)||(v191_setup_ticks>4500)) {\
printf("V191 fixed event setup overrun\n"); goto end; }\
waittimer(10000);\
starttimer();\
MR3040_Start(v191_grad_chan);

#define V191_FIXED_FINISH v191_elapsed_ticks=gettimer();\
v191_elapsed_long=UnsignedToLong(v191_elapsed_ticks);\
if ((v191_elapsed_long>IntToLong(v191_window_ticks)-4500L)||\
(v191_window_ticks<5000)||(v191_window_ticks>49000)) {\
printf("V191 fixed event playback overrun\n"); goto end; }\
waittimer(v191_window_ticks);
