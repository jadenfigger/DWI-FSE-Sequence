/****************************************************************


			TSTEX_15.PPH
		Version 1.5 18th August,1998.

This include file is the stanard test procedure to check that
the selected combination of averages, view block and slice block
are sensible. An error condition will terminate the program.

**************************************************************/

    if((no_averages/view_block)*view_block != no_averages){
	printf("\nNo. Averages not a multiple of View Block");
	goto end;
    }

    if((view_block/slice_block)*slice_block != view_block){
	printf("\nView Block not a multiple of Slice Block");
	goto end;
    }

    if (phase_cycle == 2){
	if ( (no_averages & 1) != 0){
	    printf("\nNo. Averages is not a multiple of 2");
	    goto end;
	}
    }
	
